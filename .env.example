# ==================== 高德 MCP 服务 ====================
AMAP_MCP_URL=https://mcp.amap.com/mcp?key={your_key_here}

# ==================== OpenAI 兼容大模型 ====================
# 取消注释其中一组，注释其他组

# LongCat (官方)
AI_OPENAI_MODEL=LongCat-Flash-Chat
AI_OPENAI_API_KEY=xxxxxxxxx
AI_OPENAI_BASE_URL=https://api.longcat.chat/openai/v1/

# 通义千问
# AI_OPENAI_MODEL=qwen3-max-2026-01-23
# AI_OPENAI_API_KEY=${ALIYUN_API_KEY}
# AI_OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 通用配置
AI_OPENAI_TEMPERATURE=0.8
AI_OPENAI_TIMEOUT=120
AI_OPENAI_MAX_TOKENS=4096
# tokenhub 等网关设为 true（只透传 max_tokens）；OpenAI 官方新模型可省略或设 false
AI_OPENAI_USE_MAX_TOKENS=false

# ==================== Nacos 注册/配置中心 ====================
NACOS_ADDR=localhost:8848
NACOS_USERNAME=nacos
NACOS_PASSWORD=
NACOS_CONFIG_NAMESPACE=
NACOS_DISCOVERY_NAMESPACE=
SERVICE_IP=127.0.0.1

# ==================== Redis ====================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ==================== RabbitMQ ====================
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=
RABBITMQ_VHOST=/dispatch

# ==================== MongoDB ====================
MONGO_URI=mongodb://localhost:27017
